# ---------------------------------------------------------------------------
# yt-to-tiktok - copy to .env and fill in.
# Only YOUR channel and YOUR TikTok account.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Public HTTPS origin the WebSub hub can reach (Cloudflare Tunnel, ngrok,
# reverse proxy). Without it, push notifications are off and only polling runs.
PUBLIC_URL=

# --- youtube --------------------------------------------------------------
# console.cloud.google.com -> enable "YouTube Data API v3" -> create an API key.
YOUTUBE_API_KEY=
# Get this with: npm run cli -- resolve-channel @yellowdonutt
YOUTUBE_CHANNEL_ID=
# openssl rand -hex 32
WEBSUB_SECRET=
POLL_INTERVAL_SECONDS=300
# Guards against the backlog replay YouTube sends when a subscription is first
# verified, and against re-notifications when you edit an old video's title.
MAX_VIDEO_AGE_MINUTES=120
ALLOWED_PRIVACY_STATUSES=public

# --- source ---------------------------------------------------------------
# local:   find your master file on disk (recommended - best quality)
# command: run your own command to produce the file
SOURCE_MODE=local
SOURCE_DIR=./data/masters
SOURCE_COMMAND=
# Wait this long for a master to appear before failing the job. Useful when your
# render finishes slightly after the YouTube upload does.
SOURCE_WAIT_SECONDS=0

# --- media ----------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# auto = reframe ONLY when the source is not already vertical. Footage that is
#        already 9:16 is passed through untouched - no re-encode, no quality
#        loss. This is the right setting if you shoot vertical.
# none = never reframe, whatever the source shape is
# blur = always fit the whole frame over a blurred fill
# crop = always fill and centre-crop (loses the sides)
# pad  = always letterbox onto PAD_COLOR
VERTICAL_MODE=auto
# Which strategy "auto" uses when it decides a reframe IS needed.
AUTO_REFRAME_MODE=blur
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
AUDIO_BITRATE=128k
PAD_COLOR=black
LOUDNESS_ENABLED=true
LOUDNESS_TARGET_I=-14
LOUDNESS_TARGET_TP=-1.5
LOUDNESS_TARGET_LRA=11

# --- clipping (long-form -> shorts) ---------------------------------------
CLIP_THRESHOLD_SECONDS=180
CLIP_TARGET_SECONDS=60
CLIP_MAX_COUNT=3
CLIP_HEAD_TRIM_SECONDS=0
CLIP_TAIL_TRIM_SECONDS=0

# --- tiktok ---------------------------------------------------------------
# developers.tiktok.com -> your app -> add the "Content Posting API" product.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-public-url/oauth/tiktok/callback
# inbox   = lands in your TikTok drafts, you finish and post (works unaudited)
# direct  = posts straight to your profile (needs an audited app)
# handoff = encode and hold; an external publisher collects the file. The three
#           TIKTOK_CLIENT_* values below are NOT needed in this mode.
TIKTOK_PUBLISH_MODE=inbox
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_STITCH=false
TIKTOK_CHUNK_SIZE_MB=10

# --- caption --------------------------------------------------------------
# Placeholders: {title} {description} {url} {videoId} {clip}
CAPTION_TEMPLATE={title}
CAPTION_HASHTAGS=
CAPTION_MAX_LENGTH=2200

# --- legal pages ----------------------------------------------------------
# Served at /legal/terms and /legal/privacy. TikTok requires both to be publicly
# reachable before an app can add products or be submitted for audit.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=

# --- safety ---------------------------------------------------------------
# Nothing uploads until you approve it. Turn this off deliberately, or not at all.
REQUIRE_REVIEW=true
DRY_RUN=false
# Required as `Authorization: Bearer <token>` on the review UI and /jobs.
# Set this if the server is reachable from anywhere but localhost.
REVIEW_TOKEN=
MAX_ATTEMPTS=5
LOG_LEVEL=info

# --- storage --------------------------------------------------------------
DATA_DIR=./data
WORK_DIR=./data/work
